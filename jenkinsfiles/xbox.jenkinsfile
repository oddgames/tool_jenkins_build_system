@Library('tool_jenkins_build_system@main') _

/**
 * Xbox (Microsoft GDK / GameCore) Build Pipeline
 *
 * Builds GameCoreXboxSeries (Xbox Series X|S) or GameCoreXboxOne and delivers the build folder to
 * Google Drive + the local share. There is no automated store upload: submission goes through
 * Microsoft Partner Center, and packaging (makepkg) is not run here — see "Packaging" below.
 *
 * Required Jenkins Environment Variables (set in job config):
 *   PLASTIC_REPSPEC       - PlasticSCM repository spec for game project (e.g., "UnityProj_TGW@cloud")
 *   UNITY_PROJECT_NAME    - Unity project folder name (e.g., "UnityProj_TGW")
 *   APP_NAME              - App name for build artifacts (e.g., "trucksoffroad")
 *   APP_ICON              - URL to app icon for notifications
 *   RCLONE_REMOTE         - rclone remote path (e.g., "drive:Builds")
 *
 * Optional Jenkins Environment Variables:
 *   XBOX_AGENT_LABEL      - Agent label for GDK-equipped machines (default: "Windows")
 *   IL2CPP_MAX_CORES      - Cap IL2CPP compiler parallelism (e.g. 4) on memory-constrained agents
 *
 * Required Jenkins Credentials:
 *   unity-credentials     - Username/password for Unity license
 *   rclone                - File credential containing rclone.conf
 *   github                - Username/password for GitHub (username + PAT, not password)
 *   slack-token           - Secret text for Slack build notifications (optional)
 *
 * Build Agent Requirements:
 *   - Microsoft GDK with Xbox console support (GXDK) installed. Restart the Jenkins agent service
 *     after installing so it inherits GameDK / GXDKLatest.
 *   - Visual Studio with the C++ toolchain (IL2CPP)
 *   - Unity Editor with Xbox build support at C:\UnityEditors\{VERSION}. Console modules are NOT
 *     distributed through Unity Hub - install from the Xbox developer portal.
 *
 * Unity Project Requirements:
 *   - Xbox-specific player settings that can only be set through the GameCore editor API belong in
 *     a Build Profile asset at Assets/Editor/Pipeline/BuildProfiles/Xbox{Debug,Release}.buildprofile.
 *     PipelineXbox.cs activates it when present and falls back to scripted settings when not.
 *
 * Packaging:
 *   This pipeline ships the loose GameCore layout. Packaging it into an .xvc/.msixvc with the GDK's
 *   makepkg is a manual step for now - preflightXboxGDK() logs the makepkg path when it finds one.
 */

pipeline {
    agent {
        node {
            label buildUtils.pickNode(params.NODE, env.XBOX_AGENT_LABEL ?: 'Windows', params.BRANCH)
        }
    }

    parameters {
        choice(name: 'BUILD_TYPE', choices: ['Debug', 'Release'], description: 'Build type to create')
        choice(name: 'XBOX_TARGET', choices: ['GameCoreXboxSeries', 'GameCoreXboxOne'], description: 'Xbox console to build for (Series X|S or Xbox One GDK)')
        persistentString(name: 'BRANCH', defaultValue: '/main', description: 'Branch, changeset, or full selector (e.g. /main, 9613, or 9613@branch@repo@server)')
        string(name: 'NODE', defaultValue: '', description: 'Override build agent (e.g. BUILD1). Leave blank for default.')
        extendedChoice(
            name: 'CLEAN_CACHE',
            type: 'PT_CHECKBOX',
            value: 'ShaderCache,BuildCache,ArtifactDB,Temp,ScriptAssemblies,PackageCache,Bee,IL2CPP,Addressables,Verify Workspace,Clear Library,Clear Workspace,Force Preflight',
            defaultValue: '',
            multiSelectDelimiter: ',',
            quoteValue: false,
            saveJSONParameterToFile: false,
            visibleItemCount: 13,
            description: 'Clean Unity cache dirs before build (select multiple). Verify Workspace=Force re-check all tracked files against server. Clear Library=Delete entire Library folder. Clear Workspace=Wipe entire Jenkins workspace and start from scratch. Force Preflight=Re-run all preflight checks even if they passed recently'
        )
        booleanParam(name: 'WARMUP', defaultValue: false, description: 'Cache-warming build: runs full build but skips uploads and notifications')
        text(name: 'PREBUILD_SCRIPT', defaultValue: '', description: 'One-off PowerShell to run on the agent after checkout, before the build starts. Use for agent-only fixes a clean repo can\'t make — e.g. delete stray generated files or a stale Library/Bee output. Leave blank for normal builds (resets to blank each run). Best-effort: a failure warns but does not abort unless PREBUILD_FAIL_ON_ERROR=true is set in the job environment.')
    }

    environment {
        // Build configuration — PLATFORM is passed straight to Unity as -buildTarget.
        // The elvis guard keeps PLATFORM valid if params isn't populated yet (job's first run).
        PLATFORM = "${params.XBOX_TARGET ?: 'GameCoreXboxSeries'}"

        // Paths (derived from UNITY_PROJECT_NAME)
        UNITY_PROJECT = "${WORKSPACE}/plastic/${UNITY_PROJECT_NAME}"
        BUILD_PATH = "${WORKSPACE}/build"
        ARTIFACT_PATH = "${WORKSPACE}/artifacts"

        // Environment
        LC_ALL = "en_US.UTF-8"
        LANG = "en_US.UTF-8"
        PATH = "C:\\Windows\\System32;C:\\Windows\\System32\\WindowsPowerShell\\v1.0;C:\\Ruby32-x64\\bin;C:\\Program Files\\PlasticSCM5\\client;C:\\Program Files\\Git\\bin;${env.LOCALAPPDATA}\\Microsoft\\WindowsApps;${env.PATH}"

        // GitHub credentials for Unity package downloads and library SCM checkout
        GITHUB_TOKEN = credentials('github')
    }

    options {
        skipDefaultCheckout()
    }

    stages {
        stage('Validate') {
            steps {
                script {
                    env.CURRENT_STAGE = 'Validate'
                    buildUtils.init(buildType: params.BUILD_TYPE, branch: params.BRANCH)  // Initialize early for post handlers
                    if (params.WARMUP) {
                        currentBuild.displayName = "#${env.BUILD_NUMBER} [Warmup] ${params.BUILD_TYPE}"
                    }
                    buildUtils.purgeWorkspace(params.CLEAN_CACHE)  // Wipe workspace before checkout if "Clear Workspace" selected
                    def required = ['PLASTIC_REPSPEC', 'UNITY_PROJECT_NAME', 'APP_NAME', 'APP_ICON', 'RCLONE_REMOTE']
                    def missing = required.findAll { !env[it]?.trim() }
                    if (missing) error "Missing env vars: ${missing.join(', ')}\nSet in: Job > Configure > Environment Variables"
                    echo "[Config] Project=${env.UNITY_PROJECT_NAME} AppName=${env.APP_NAME} Target=${env.PLATFORM}"
                }
            }
        }

        stage('Checkout') {
            steps {
                script {
                    env.CURRENT_STAGE = 'Checkout'

                    // Ensure Plastic SCM profile is configured before any cm commands
                    buildUtils.preflightPlasticSCM()

                    // Parse selector: /main or 9613
                    def sel = buildUtils.parseSelector(params.BRANCH)

                    echo "[Checkout] Input: '${params.BRANCH}' -> changeset: ${sel.changeset}, branch: ${sel.branch}"

                    buildUtils.cleanPlasticWorkspace(params.CLEAN_CACHE)

                    def scmVars = buildUtils.plasticCheckout(
                        branch: sel.branch,
                        changeset: sel.changeset
                    )

                    env.PLASTICSCM_CHANGESET_ID = scmVars.PLASTICSCM_CHANGESET_ID
                    env.PLASTICSCM_BRANCH = scmVars.PLASTICSCM_BRANCH
                    env.PLASTICSCM_AUTHOR = scmVars.PLASTICSCM_AUTHOR
                    env.CHANGESET_ID = scmVars.PLASTICSCM_CHANGESET_ID
                    env.BRANCH = scmVars.PLASTICSCM_BRANCH
                    env.PLASTIC_CHANGESET_GUID = scmVars.PLASTICSCM_CHANGESET_GUID
                }
            }
        }

        stage('Pre-Build Script') {
            when {
                expression { params.PREBUILD_SCRIPT?.trim() }
            }
            steps {
                script {
                    env.CURRENT_STAGE = 'Pre-Build Script'
                    buildUtils.runPrebuildScript(params.PREBUILD_SCRIPT)
                }
            }
        }

        stage('Startup') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'unity-credentials', usernameVariable: 'UNITY_USERNAME', passwordVariable: 'UNITY_PASSWORD')]) {
                    script {
                        env.CURRENT_STAGE = 'Startup'
                        buildUtils.copyPipelineScripts()
                        buildUtils.startup(params.BUILD_TYPE, env.BRANCH)
                        buildUtils.capTextures()
                    }
                    bat 'set'
                }
            }
        }

        stage('Extract Version') {
            steps {
                script {
                    env.CURRENT_STAGE = 'Extract Version'
                    buildUtils.extractUnityVersion(env.UNITY_PROJECT)
                }
            }
        }

        stage('Winget') {
            steps {
                script {
                    env.CURRENT_STAGE = 'Winget'
                    buildUtils.preflightWinget()
                }
            }
        }

        stage('Unity') {
            when {
                expression {
                    return !buildUtils.shouldSkipPreflight() || params.CLEAN_CACHE?.contains('Force Preflight')
                }
            }
            steps {
                script {
                    env.CURRENT_STAGE = 'Preflight: Unity'
                    buildUtils.validateUnityInstallation()
                }
            }
        }

        stage('Preflight Checks') {
            when {
                expression {
                    return !buildUtils.shouldSkipPreflight() || params.CLEAN_CACHE?.contains('Force Preflight')
                }
            }
            parallel {
                stage('Network') {
                    steps {
                        script {
                            env.CURRENT_STAGE = 'Preflight: Network'
                            buildUtils.preflightNetwork()
                        }
                    }
                }

                stage('Jenkins Permissions') {
                    steps {
                        script {
                            env.CURRENT_STAGE = 'Preflight: Jenkins Permissions'
                            buildUtils.preflightJenkinsPermissions()
                        }
                    }
                }

                stage('rclone') {
                    steps {
                        script {
                            env.CURRENT_STAGE = 'Preflight: rclone'
                            buildUtils.preflightRclone()
                        }
                    }
                }

                stage('PlasticSCM') {
                    steps {
                        script {
                            env.CURRENT_STAGE = 'Preflight: PlasticSCM'
                            buildUtils.preflightPlasticSCM()
                        }
                    }
                }

                stage('Visual Studio') {
                    steps {
                        script {
                            env.CURRENT_STAGE = 'Preflight: Visual Studio'
                            buildUtils.preflightVisualStudio()  // IL2CPP needs the C++ toolchain
                        }
                    }
                }

                stage('Long Paths') {
                    steps {
                        script {
                            env.CURRENT_STAGE = 'Preflight: Long Paths'
                            buildUtils.preflightLongPaths()
                        }
                    }
                }

                stage('Python') {
                    steps {
                        script {
                            env.CURRENT_STAGE = 'Preflight: Python'
                            buildUtils.preflightPython()
                        }
                    }
                }

                stage('UnityDataTool') {
                    steps {
                        script {
                            env.CURRENT_STAGE = 'Preflight: UnityDataTool'
                            buildUtils.preflightUnityDataTool()
                        }
                    }
                }
            }
            post {
                success {
                    script {
                        buildUtils.markPreflightPassed()
                    }
                }
            }
        }

        stage('Unity License') {
            steps {
                script {
                    env.CURRENT_STAGE = 'Unity License'
                    buildUtils.preflightUnityLicense()
                }
            }
        }

        stage('Setup') {
            stages {
                stage('Xbox GDK') {
                    steps {
                        script {
                            env.CURRENT_STAGE = 'Xbox GDK'
                            buildUtils.preflightXboxGDK()
                        }
                    }
                }

                stage('Validate Xbox Support') {
                    steps {
                        script {
                            env.CURRENT_STAGE = 'Validate Xbox Support'
                            buildUtils.validateXboxSupport()
                        }
                    }
                }

                stage('Calculate Build Version') {
                    steps {
                        script {
                            env.CURRENT_STAGE = 'Calculate Build Version'
                            env.VERSION = "${env.BASE_VERSION}.${env.CHANGESET_ID}.${env.BUILD_NUMBER}"
                            echo "[OK] Full Version: ${env.VERSION}"
                        }
                    }
                }
            }
        }

        stage('Cache Integrity') {
            steps {
                script {
                    env.CURRENT_STAGE = 'Cache Integrity'
                    buildUtils.checkCacheValidity(env.UNITY_PROJECT)
                }
            }
        }

        stage('Clean Unity Cache') {
            when {
                expression { params.CLEAN_CACHE }
            }
            steps {
                script {
                    env.CURRENT_STAGE = 'Clean Unity Cache'
                    buildUtils.cleanUnityCache(env.UNITY_PROJECT, params.CLEAN_CACHE)
                }
            }
        }

        stage('Unity Prepare') {
            steps {
                script { env.CURRENT_STAGE = 'Unity Prepare' }
                withCredentials([
                    usernamePassword(credentialsId: 'unity-credentials', usernameVariable: 'UNITY_USERNAME', passwordVariable: 'UNITY_PASSWORD')
                ]) {
                    script {
                        buildUtils.runUnityCommand(
                            unityProjectPath: env.UNITY_PROJECT,
                            platform: env.PLATFORM,
                            executeMethod: "ODDFramework.PipelineXbox.Prepare${params.BUILD_TYPE}",
                            quit: true,
                            buildPath: env.BUILD_PATH,
                            artifactPath: env.ARTIFACT_PATH
                        )
                    }
                }
            }
        }

        stage('Unity Build') {
            steps {
                script { env.CURRENT_STAGE = 'Unity Build' }
                withCredentials([
                    usernamePassword(credentialsId: 'unity-credentials', usernameVariable: 'UNITY_USERNAME', passwordVariable: 'UNITY_PASSWORD')
                ]) {
                    script {
                        buildUtils.runUnityCommand(
                            unityProjectPath: env.UNITY_PROJECT,
                            platform: env.PLATFORM,
                            executeMethod: "ODDFramework.PipelineXbox.${params.BUILD_TYPE}"
                        )
                    }
                }
            }
        }

        stage('Addressables Check') {
            steps {
                script {
                    env.CURRENT_STAGE = 'Addressables Check'
                    // Warn-only: if the Unity build left a broken-Addressables report (catalog
                    // entries with no location), flag the build UNSTABLE. Does not stop the
                    // pipeline — the build still completes and uploads.
                    buildUtils.checkBrokenAddressables()
                }
            }
        }

        stage('Log Build Outputs') {
            steps {
                script {
                    env.CURRENT_STAGE = 'Log Build Outputs'
                    buildUtils.logBuildOutputs("${env.BUILD_PATH}\\output")
                }
            }
        }

        stage('Upload Notification') {
            when {
                expression { !params.WARMUP }
            }
            steps {
                script {
                    buildUtils.sendUploadNotification(
                        buildType: params.BUILD_TYPE,
                        appIcon: env.APP_ICON,
                        branch: env.BRANCH,
                        changesetId: env.CHANGESET_ID,
                        uploads: ['local', 'gdrive']
                    )
                }
            }
        }

        stage('Parallel Post-Build') {
            failFast false
            parallel {
                stage('Local Share') {
                    when {
                        expression { !params.WARMUP }
                    }
                    steps {
                        script {
                            env.CURRENT_STAGE = 'Local Share'
                            buildUtils.uploadToLocalShare(
                                buildPath: "${env.BUILD_PATH}\\output",
                                buildType: params.BUILD_TYPE
                            )
                        }
                    }
                }

                stage('Unity Data Tool') {
                    steps {
                        script {
                            env.CURRENT_STAGE = 'Unity Data Tool'
                            buildUtils.runUnityDataTool()
                        }
                    }
                }

                stage('Google Drive Upload') {
                    when {
                        expression { !params.WARMUP }
                    }
                    steps {
                        script {
                            env.CURRENT_STAGE = 'Google Drive Upload'
                        }
                        withCredentials([file(credentialsId: 'rclone', variable: 'RCLONE_CONFIG')]) {
                            script {
                                // GameCore ships a folder layout, not a single installable file
                                buildUtils.uploadFolderToGoogleDrive(
                                    buildPath: "${env.BUILD_PATH}\\output",
                                    destFolder: "${env.JOB_NAME}/${env.VERSION}"
                                )
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                if (!params.WARMUP) {
                    buildUtils.handleBuildSuccess(
                        buildType: params.BUILD_TYPE,
                        appIcon: env.APP_ICON,
                        branch: env.BRANCH,
                        changesetId: env.CHANGESET_ID
                    )
                }
            }
        }
        unstable {
            script {
                if (!params.WARMUP) {
                    buildUtils.handleBuildUnstable(
                        buildType: params.BUILD_TYPE,
                        appIcon: env.APP_ICON,
                        branch: env.BRANCH,
                        changesetId: env.CHANGESET_ID
                    )
                }
            }
        }
        failure {
            script {
                if (!params.WARMUP) {
                    buildUtils.handleBuildFailure(
                        buildType: params.BUILD_TYPE,
                        appIcon: env.APP_ICON,
                        branch: env.BRANCH,
                        changesetId: env.CHANGESET_ID
                    )
                }
            }
        }
        aborted {
            script {
                if (!params.WARMUP) {
                    buildUtils.handleBuildAborted(
                        buildType: params.BUILD_TYPE,
                        appIcon: env.APP_ICON,
                        branch: env.BRANCH,
                        changesetId: env.CHANGESET_ID
                    )
                }
            }
        }
        always {
            script {
                buildUtils.collectUnityErrors()
            }
            script {
                if (!params.WARMUP) {
                    buildUtils.finalizeBuild(
                        buildType: params.BUILD_TYPE,
                        appIcon: env.APP_ICON,
                        branch: env.BRANCH,
                        changesetId: env.CHANGESET_ID
                    )
                }
            }
            dir('artifacts') {
                archiveArtifacts artifacts: "**/*", fingerprint: true, allowEmptyArchive: true
            }
            script {
                buildUtils.cleanupAtWorkspaces()
            }
        }
    }
}
